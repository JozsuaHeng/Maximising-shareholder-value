{
  "name": "maximising-shareholder-value",
  "main": "worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "HOME_CACHE", "id": "df39e229e1544feea93c4f806458f93d" }
  ]
}
